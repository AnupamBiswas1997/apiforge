# =============================================================================
# APIForge — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your chosen LLM provider.
# Only the provider you select via LLM_PROVIDER needs a key at startup.
# You can also connect or switch providers at runtime via the /connect page.
# =============================================================================

# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------

# Port for the Express backend (default: 3001)
PORT=3001

# Directory where run JSON files are persisted (default: ./data/runs)
DATA_DIR=./data/runs

# Node environment: development | production
NODE_ENV=development

# Set to "true" to log full LLM prompts and raw responses for each pipeline step
PIPELINE_DEBUG=false

# Set to "true" to skip TLS certificate verification for ALL API test requests.
# 
# NOTE: APIForge auto-detects certificate errors and retries without verification
# automatically — so you may NOT need this flag at all. It only skips the first
# (secure) attempt, saving ~1 second per failing request in environments like
# Mars UAT where every request would cert-fail then auto-retry.
#
# Required for: Mars UAT, internal corporate APIs, self-signed certificates.
# WARNING: Never enable against public production APIs.
ALLOW_INSECURE_TLS=false

# CORS origin(s) for production — comma-separated list of allowed origins.
# In development, all origins are allowed. Set this in production.
# CORS_ORIGINS=https://apiforge.yourdomain.com

# -----------------------------------------------------------------------------
# LLM PROVIDER — Choose one of: anthropic | openai | gemini | mistral | ollama
# -----------------------------------------------------------------------------

# The active provider key. Must be one of the 5 supported values above.
# Can also be switched at runtime via the /connect page without restarting.
LLM_PROVIDER=anthropic

# -----------------------------------------------------------------------------
# ANTHROPIC CLAUDE
# Sign up: https://console.anthropic.com
# Docs:    https://docs.anthropic.com/en/api/getting-started
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# -----------------------------------------------------------------------------
# OPENAI
# Sign up: https://platform.openai.com
# Docs:    https://platform.openai.com/docs/api-reference
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# -----------------------------------------------------------------------------
# GOOGLE GEMINI
# Sign up: https://aistudio.google.com
# Docs:    https://ai.google.dev/api/rest
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# -----------------------------------------------------------------------------
# MISTRAL AI
# Sign up: https://console.mistral.ai
# Docs:    https://docs.mistral.ai/api
# -----------------------------------------------------------------------------
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# -----------------------------------------------------------------------------
# OLLAMA (local — no API key needed)
# Install: https://ollama.com
# Docs:    https://github.com/ollama/ollama/blob/main/docs/api.md
# Run:     ollama serve && ollama pull llama3
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# -----------------------------------------------------------------------------
# MARS MAX LLM Gateway (Mars internal AI platform)
# Token format: pk-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Contact your Mars DNA / AI platform team to get a bearer token.
# NOTE: The UAT gateway uses a self-signed certificate — this is handled
# automatically by the adapter (rejectUnauthorized: false for this provider only).
# -----------------------------------------------------------------------------
MARSMAX_API_KEY=pk-02ee64f7-0b3a-491b-af14-4fe113144bfc
MARSMAX_MODEL=auto

# -----------------------------------------------------------------------------
# OPENROUTER — unified gateway to 200+ models
# Sign up: https://openrouter.ai
# Browse models: https://openrouter.ai/models
# Model IDs are namespaced: "anthropic/claude-sonnet-4-5", "openai/gpt-4o", etc.
# Free tier: append ":free" e.g. "meta-llama/llama-3-8b-instruct:free"
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4-5
